# Use a same-origin /api proxy in production. Never put secrets in VITE_*.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=https://t0k1.duckdns.org
# auto supports the deployed JSON refresh response and the next cookie release.
VITE_AUTH_TRANSPORT=auto
# Keep POST for the current deployment; set GET only with the corresponding BE release.
VITE_EMAIL_CHECK_METHOD=POST
